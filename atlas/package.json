{
  "name": "atlas",
  "version": "0.1.328",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/build-mdi-icon-catalog.mjs && node scripts/build-file-studio-editor.mjs && node scripts/build-terminal-plugin.mjs",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:app": "node --test scripts/atlas-admin-connection-store.test.mjs scripts/atlas-homeassistant-version.test.mjs scripts/atlas-plugin-compatibility.test.mjs scripts/atlas-plugin-recovery.test.mjs scripts/atlas-plugin-lifecycle.test.mjs scripts/atlas-plugin-management.test.mjs scripts/atlas-editor-projects.test.mjs scripts/atlas-file-studio-retention.test.mjs scripts/atlas-request-origin.test.mjs scripts/home-assistant-package.test.mjs",
    "start:app": "node scripts/atlas-app-server.mjs",
    "linux:prepare": "node scripts/atlas-linux-installer.mjs prepare --output output/linux-runtime",
    "test:linux": "node --test scripts/atlas-linux-installer.test.mjs",
    "test:frontend": "node --test scripts/atlas-frontend-panel.test.mjs scripts/atlas-editor-drafts.test.mjs",
    "ha:app:prepare": "node scripts/prepare-home-assistant-app.mjs",
    "ha:app:sync": "node scripts/sync-home-assistant-app.mjs",
    "ha:app:check": "node scripts/sync-home-assistant-app.mjs --check",
    "docker:build": "docker build -t atlas:local .",
    "docker:up": "docker compose up --build",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@lezer/highlight": "^1.2.3",
    "@mdi/svg": "7.4.47",
    "@types/node": "^24.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "semver": "7.8.5",
    "tar": "^7.5.22",
    "ws": "^8.21.3"
  }
}
