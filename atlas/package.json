{
  "name": "atlas",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/build-file-studio-editor.mjs",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "start:app": "node scripts/atlas-app-server.mjs",
    "ha:app:prepare": "node scripts/prepare-home-assistant-app.mjs",
    "docker:build": "docker build -t atlas:local .",
    "docker:up": "docker compose up --build",
    "clean": "pnpm -r exec rimraf dist"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
